# Groq LLM API Key (get free key from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# GitHub OAuth App (create at github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Session Secret
SESSION_SECRET=some-random-secret-string

# Public URL of this server (for workflow templates)
AGENT_PUBLIC_URL=http://localhost:8000

# Slack Incoming Webhook URL (optional)
SLACK_WEBHOOK_URL=

# Database
DB_HOST=localhost
DB_PORT=5433
DB_NAME=auditlog
DB_USER=admin
DB_PASSWORD=password
